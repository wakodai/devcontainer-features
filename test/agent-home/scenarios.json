{
    "non_root_user": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "remoteUser": "vscode",
        "features": {
            "agent-home": {}
        }
    },
    "project_mounts_claude": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "remoteUser": "vscode",
        "mounts": [
            "source=${localEnv:HOME}/dummy-claude,target=/home/vscode/.claude,type=bind"
        ],
        "features": {
            "agent-home": {}
        }
    },
    "project_sets_codex_home": {
        "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
        "remoteUser": "vscode",
        "containerEnv": {
            "CODEX_HOME": "/home/vscode/project-codex"
        },
        "features": {
            "agent-home": {}
        }
    }
}
